# Настройки xray-checker — только если поднимаете его профилем checker
# (docker compose --profile checker up -d). Скопировать в .env.checker.
#
# Проверки «из мира»: чекер поднимает настоящий клиент и ходит через каждый сервер
# из подписки. Ссылка подписки — это ключ доступа: не коммитить, в чат не пересылать.
# Заведите для проверок отдельного пользователя, чтобы отзыв подписки не задевал
# живых клиентов.

SUBSCRIPTION_URL=https://panel.example.com/sub/xxxxxxxxxxxx

PROXY_CHECK_METHOD=status
PROXY_CHECK_INTERVAL=300
SUBSCRIPTION_UPDATE=true
SUBSCRIPTION_UPDATE_INTERVAL=3600

# Без защиты метрик внутри docker-сети /api/v1/proxies открыт всем контейнерам.
# Порт наружу не публикуется, но защиту всё равно оставляем: .env должен содержать
# CHECKER_USER/CHECKER_PASSWORD ровно с этими значениями.
METRICS_PROTECTED=true
METRICS_USERNAME=probe
METRICS_PASSWORD=заменить-на-свой-пароль

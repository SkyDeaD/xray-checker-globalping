# Настройки сервиса. Скопировать в .env и вписать своё.
#
# Минимум, чтобы заработало: PANEL_URL и PANEL_TOKEN. Всё остальное — по желанию.
# Файл читают и docker compose (как переменные), и сам сервис (как окружение).

# ---------------------------------------------------------------- откуда берём серверы
# Источников три. Побеждает первый настроенный, по порядку: TARGETS → панель → подписка.

# 1) Панель Remnawave: локации = страны её хостов. Порт и адрес панели, к которой
#    сервис имеет доступ (та же docker-сеть, localhost или внешний адрес).
PANEL_URL=https://panel.example.com
#    API-токен панели. Это секрет: не публиковать, в чат не пересылать.
PANEL_TOKEN=
#    Необязательно: squad «белых списков». Хосты с его inbound'ами покажем отдельной
#    локацией (NL-wl) с пометкой «белые списки». Пусто — не делим.
WHITELIST_SQUAD_UUID=

# 2) Свои цели вручную: «Имя=host:port» через запятую, по одной на локацию.
#    Задан — важнее панели и подписки.
TARGETS=

# 3) Подписка xray-checker. Нужен только если хотите колонку «из мира»:
#    поднимите его профилем checker (ниже) и раскомментируйте URL.
#    CHECKER_USER/PASSWORD должны совпадать с METRICS_USERNAME/PASSWORD в .env.checker.
# CHECKER_URL=http://xray-checker:2112
# CHECKER_USER=probe
# CHECKER_PASSWORD=

# ---------------------------------------------------------------- проверки из России
# Токен Globalping (Dashboard → API tokens). Пусто — проверок «из России» не будет,
# останется только колонка «из мира». Без токена лимит 250 тестов/час, с ним — 500.
GLOBALPING_TOKEN=
# Зонды: страна и теги. eyeball-network — домашние провайдеры, а не дата-центры.
RU_COUNTRY=RU
RU_TAGS=eyeball-network
# Зондов в одном измерении. 1 зонд = 1 тест квоты.
RU_PROBES=20
# Как часто опрашивать зонды, секунды. Проверяется ПЕРВАЯ цель каждой локации.
# Интервал сам растёт, если бюджет квоты (450 тестов/час) не влезает.
RU_INTERVAL=900

# ---------------------------------------------------------------- проверки «из мира»
# Как часто читать xray-checker, секунды.
WORLD_INTERVAL=300

# ---------------------------------------------------------------- прочее
# Показывать адреса и порты в /api/status. По умолчанию нет: публичный ответ не
# должен превращаться в список целей для блокировки. На страницу они не попадают никогда.
EXPOSE_TARGETS=false
DB_PATH=/data/status.db
CACHE_TTL=60
LOG_LEVEL=INFO

# Настройки xray-checker (файл для контейнера xray-checker). Скопировать в .env
#
# SUBSCRIPTION_URL — ссылка подписки того клиента, чьи серверы проверяем. Это ключ
# доступа: не коммитить, в логи не выводить. Отдельного пользователя заводить
# удобнее — тогда отзыв подписки не задевает живых клиентов.

SUBSCRIPTION_URL=https://panel.example.com/sub/xxxxxxxxxxxxxxxx

# Проверка идёт настоящим клиентом через прокси: success по HTTP 204.
PROXY_CHECK_METHOD=status
PROXY_CHECK_INTERVAL=300
SUBSCRIPTION_UPDATE=true
SUBSCRIPTION_UPDATE_INTERVAL=3600

# Без защиты метрик наружу уходит и /api/v1/proxies с адресами серверов.
# Порт внутри docker-сети, но защиту всё равно включаем.
METRICS_PROTECTED=true
METRICS_USERNAME=probe
METRICS_PASSWORD=заменить-на-свой-пароль

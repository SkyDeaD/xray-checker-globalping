# Настройки нашего сервиса (файл для контейнера probe). Скопировать в probe.env

# Доступ к xray-checker: логин/пароль из METRICS_USERNAME/METRICS_PASSWORD (.env).
# CHECKER_URL в compose задан явно — здесь он нужен только для запуска без compose.
CHECKER_URL=http://xray-checker:2112
CHECKER_USER=probe
CHECKER_PASSWORD=заменить-на-свой-пароль

# Токен Globalping (Dashboard → API tokens). Пусто — проверки «из России» выключены.
# Без токена лимит 250 тестов/час, с бесплатным токеном — 500.
GLOBALPING_TOKEN=

# Зонды: страна и теги. eyeball-network — домашние провайдеры (без дата-центров).
RU_COUNTRY=RU
RU_TAGS=eyeball-network
# Сколько зондов в одном измерении. 1 зонд = 1 тест квоты.
RU_PROBES=20

# Интервалы, секунды. Раз в RU_INTERVAL проверяется ПЕРВАЯ цель каждой локации.
# Интервал автоматически растёт, если бюджета квоты (450 тестов/час) не хватает.
WORLD_INTERVAL=300
RU_INTERVAL=900

# Локации вручную: «Имя=host:port» через запятую. Пусто — берутся из подписки
# xray-checker (локация = группа подписки, серверы группы — её цели).
# Задавать вручную удобно, когда нужно проверить каждый сервер по отдельности.
TARGETS=

# Показывать адреса и порты в /api/status. По умолчанию нет: публичный ответ
# не должен превращаться в список целей для блокировки.
EXPOSE_TARGETS=false

# Прочее
DB_PATH=/data/status.db
CACHE_TTL=60
LOG_LEVEL=INFO
